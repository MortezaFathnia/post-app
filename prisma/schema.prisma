generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum ContractType {
  MORABAHA
  CREDIT_CARD
  DEBT_DISCOUNTING
}

enum LoanType {
  MATURITY
  INSTALLMENT
}

enum CustomerRole {
  CUSTOMER
  BORROWER
  GUARANTOR_1
  GUARANTOR_2
  GUARANTOR_3
}

model Customer {
  id                       Int          @id @default(autoincrement())
  contractCode             String
  role                     CustomerRole

  // Individual information
  name                     String?
  lastName                 String?
  fatherName               String?
  birthDate                String?
  birthCertificateNumber   String?
  birthPlace               String?
  birthCertificateSerial   String?
  nationalCode             String?
  passportNumber           String?
  occupation               String?
  installmentAmount        String?

  // Contact and residence
  residence                String?
  address                  String?
  workAddress              String?
  landline                 String?
  workPhone                String?
  mobile                   String?

  // Bank information
  accountNumber            String?
  accountOpeningDate       String?
  longTermDepositNumber    String?
  longTermDepositAmount    String?
  customerNumber           String?

  // Company information
  companyName              String?
  registrationNumber       String?
  registrationDate         String?
  registrationOffice       String?
  companyEconomicCode      String?
  companyNationalId        String?

  contract                 ContractDetails @relation(
    fields: [contractCode],
    references: [contractCode],
    onDelete: Cascade
  )

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([contractCode, role])
  @@index([nationalCode])
}

model DebtDiscountingFacility {
  id             Int            @id @default(autoincrement())
  contractId     Int
  facilityNumber String?
  facilityTitle  String?
  counterLabel   String?
  serial         String?
  status         String         @default("فعال")
  startDate      String
  endDate        String
  contract       BayeganiRecord @relation(fields: [contractId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([contractId])
  @@index([facilityNumber])
  @@index([status])
}

model FacilityCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
