generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BayeganiRecord {
  id              Int      @id @default(autoincrement())
  sourceFile      String
  sheetName       String
  sourceRow       Int
  facilityNumber  String?
  customerNumber  String?
  archiveCode     String?
  facilityTitle   String?
  serial          String?  @unique
  serialSort      BigInt?
  classification  String?
  counterName     String?
  counterCode     String?
  counterLabel    String?
  status          String?
  startDate       String?
  endDate         String?
  duration        String?
  approvedAmount  String?
  remainingAmount String?
  nationalId      String?
  rawData         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceFile, sheetName, sourceRow])
  @@index([facilityNumber])
  @@index([customerNumber])
  @@index([archiveCode])
  @@index([serialSort])
}

model BajehCode {
  id        Int      @id @default(autoincrement())
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, name])
  @@index([code])
  @@index([name])
  @@map("bajehCode")
}
