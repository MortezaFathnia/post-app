generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractType {
  MORABAHA
  CREDIT_CARD
  DEBT_DISCOUNTING
  INTEREST_FREE_LOAN
}

enum LoanType {
  MATURITY
  INSTALLMENT
}

enum CustomerRole {
  CUSTOMER
  BORROWER
  GUARANTOR_1
  GUARANTOR_2
  GUARANTOR_3
}

model Customer {
  id                     Int               @id @default(autoincrement())
  name                   String?
  lastName               String?
  fatherName             String?
  birthDate              String?
  birthCertificateNumber String?
  birthPlace             String?
  birthCertificateSerial String?
  personType             String            @default("حقیقی")
  nationalCode           String?           @unique
  postalCode             String?
  passportNumber         String?
  occupation              String?
  installmentAmount      String?
  residence              String?
  address                String?
  workAddress            String?
  landline               String?
  workPhone              String?
  mobile                 String?
  accountNumber          String?
  accountOpeningDate     String?
  longTermDepositNumber  String?
  longTermDepositAmount  String?
  customerNumber         String?            @unique
  companyName            String?
  registrationNumber     String?
  registrationDate       String?
  registrationOffice     String?
  companyEconomicCode    String?
  companyNationalId      String?
  contractLinks          ContractCustomer[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}
model ContractDetails {
  id                        Int              @id @default(autoincrement())
  facilityNumber            String?          @unique
  contractReference         String?
  contractNumber            String?
  creationSource            String           @default("MANUAL")
  contractType              ContractType       @default(MORABAHA)
  loanType                  LoanType?
  contractDate              String?
  requestNumber             String?
  requestDate               String?
  approvalNumber            String?
  approvalDate              String?
  maturityDate              String?
  facilityDescription       String?
  economicSector            String?
  useOfFunds                String?
  transactionDescription    String?
  salePrice                 String?
  salePriceWords            String?
  purchasePrice             String?
  profitAmount              String?
  interestRate              String?
  latePaymentBaseRate       String?
  latePaymentRate           String?
  prepayment                String?
  payableAmount             String?
  facilityAmount            String?
  contractDuration          String?
  repaymentMethod           String?
  gracePeriod               String?
  installmentCount          String?
  repaymentMethod           String?
  installmentInterval       String?
  firstInstallmentDate      String?
  firstQardInstallmentDate  String?
  bankParticipationPercent  String?
  proposedPartnershipProfit String?
  proposedMudarabahProfit   String?
  collateralType            String?
  collateralDescription     String?
  collateralValue           String?
  customerLinks             ContractCustomer[]
  bayeganiRecords           BayeganiRecord[]
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
}

model ContractCustomer {
  facilityNumber String
  customerNumber String
  role           CustomerRole
  contract       ContractDetails @relation(fields: [facilityNumber], references: [facilityNumber], onDelete: Cascade, onUpdate: Cascade)
  customer      Customer        @relation(fields: [customerNumber], references: [customerNumber], onDelete: Cascade, onUpdate: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@id([facilityNumber, customerNumber])
  @@unique([facilityNumber, role])
  @@index([customerNumber])
}

model BankDetails {
  id                 Int             @id @default(autoincrement())
  bankName           String?
  branchName         String?
  branchCode         String?
  branchPostalCode   String?
  branchPhone        String?
  branchAddress      String?
  branchManager      String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model CounterDetails {
  id                 Int      @id @default(autoincrement())
  counterName        String?
  counterCode        String?
  brokerName         String?
  brokerCustomerCode String?
  bankRepresentative String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BayeganiRecord {
  id                        Int                       @id @default(autoincrement())
  sourceFile                String
  sheetName                 String
  sourceRow                 Int
  facilityNumber            String?
  personType                String                      @default("حقیقی")
  customerNumber            String?
  archiveCode               String?
  facilityTitle             String?
  serial                    String? @unique
  serialSort                BigInt?
  classification            String?
  counterName               String?
  counterCode               String?
  counterLabel              String?
  status                    String?                   @default("فعال")
  startDate                 String?
  endDate                   String?
  bailDeliveryDate          String?
  duration                  String?
  installmentCount          String?
  approvedAmount            String?
  remainingAmount           String?
  nationalId                String?
  facilityCode              String?
  facilityCodeDetails       FacilityCode?             @relation(fields: [facilityCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  contractDetails           ContractDetails?          @relation(fields: [facilityNumber], references: [facilityNumber], onDelete: SetNull, onUpdate: Cascade)
  rawData                   Json
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  debtDiscountingFacilities DebtDiscountingFacility[]
  debtDocuments             DebtDocument[]

  @@unique([sourceFile, sheetName, sourceRow])
  @@index([facilityNumber])
  @@index([customerNumber])
  @@index([nationalId])
  @@index([archiveCode])
  @@index([serialSort])
  @@index([facilityCode])
}

model DebtDiscountingFacility {
  id             Int            @id @default(autoincrement())
  contractId     Int
  facilityNumber String?
  facilityTitle  String?
  counterLabel   String?
  serial         String?
  status         String         @default("فعال")
  startDate      String
  endDate        String
  contract       BayeganiRecord @relation(fields: [contractId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([contractId])
  @@index([facilityNumber])
  @@index([status])
}

model FacilityCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bayeganiRecords BayeganiRecord[]
}


model FacilityClassification {
  id             Int      @id @default(autoincrement())
  classification Int      @unique
  facilityType   String?
  duration       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Bank {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  bankId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BajehCode {
  id        Int      @id @default(autoincrement())
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, name])
  @@index([code])
  @@index([name])
  @@map("bajehCode")
}

model DebtDiscountingRecord {
  id                   Int      @id @default(autoincrement())
  sourceFile           String
  sheetName            String
  sourceRow            Int
  counterLabel         String
  facilityNumber       String
  customerNumber       String?
  serial               String?
  checkNumber          String?
  checkStatus          String   @default("درراه")
  domesticForeign      String?
  dueDate              String?
  paidAmount           String?
  unpaidAmount         String?
  embeddedProfit       String?
  delayDays            String?
  delayPenalty         String?
  bankAgent            String?
  checkBranch          String?
  description          String?
  administrativeNumber String?
  rawData              Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([facilityNumber])
  @@index([counterLabel])
  @@unique([checkNumber, administrativeNumber])
  @@index([sourceFile, sheetName])
}

model DebtDocument {
  id             Int             @id @default(autoincrement())
  contractId     Int?            @unique
  facilityNumber String?
  facilityTitle  String?
  counterLabel   String?
  serial         String?
  status         String          @default("فعال")
  startDate      String?
  endDate        String?
  contract       BayeganiRecord? @relation(fields: [contractId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([facilityNumber])
  @@index([status])
}